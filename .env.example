# ---------------------------------------------------------------------------
# OpsDesk AI configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose publishes the database on POSTGRES_PORT)
POSTGRES_USER=opsdesk
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=opsdesk
POSTGRES_PORT=5433
DATABASE_URL=postgres://opsdesk:change-me-local-db-password@localhost:5433/opsdesk
# Used only by the automated test suite (it is wiped on every test run)
TEST_DATABASE_URL=postgres://opsdesk:change-me-local-db-password@localhost:5433/opsdesk_test

# Sessions — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_MAX_AGE_HOURS=8
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API (dev server + docker web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Number of reverse proxies in front of the API ("true" = 1). docker compose (nginx): true.
# Vercel → Render: 2. Required for correct client IPs (rate limiting) and Secure cookies.
TRUST_PROXY=false

# Demo seed data (local development only — the seed refuses to run in production)
SEED_DEMO_PASSWORD=OpsDesk-Demo-2026!

# Google Gemini (leave GEMINI_API_KEY empty to run with the AI assistant disabled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_PER_MINUTE=15

# n8n webhook integration (leave URL empty to disable outbound events)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=replace-with-a-shared-hmac-secret
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_POLL_INTERVAL_MS=5000
# Base URL used to build ticket links inside notification payloads
APP_BASE_URL=http://localhost:5173

# Rate limiting for authentication endpoints
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
